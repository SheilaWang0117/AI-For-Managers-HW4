# Private local catalogue data: never publish the database or supplied photos.
data/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.jpg
*.jpeg
*.png
*.webp
*.gif
*.avif
*.heic

# Only the requested app-check screenshots are allowed image files in Git.
!output/app_check_images/
!output/app_check_images/*.png

# Secrets and local environments
.env
.env.*
!.env.example
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store

# Frontend dependencies and generated output
node_modules/
dist/
*.tsbuildinfo
test-results/
playwright-report/
